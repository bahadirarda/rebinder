{
  "description": "Injects consent-gated proactive handoff offers and records authoritative Claude rate-limit failures for out-of-band rescue.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rebinder",
            "args": ["continuity", "hook"],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rebinder",
            "args": ["continuity", "hook"],
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "rebinder",
            "args": ["continuity", "failure"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
