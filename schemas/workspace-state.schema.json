{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebinder.dev/schemas/0.1.0/workspace-state.schema.json",
  "title": "Canonical workspace state",
  "type": "object",
  "additionalProperties": false,
  "required": ["cwd", "roots", "files", "environment"],
  "properties": {
    "cwd": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/root" }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "environment": {
      "type": "array",
      "items": { "$ref": "#/$defs/environmentEntry" }
    }
  },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["workspace", "repository", "external"] }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "state": { "enum": ["tracked", "untracked", "ignored", "external"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "environmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "redacted"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "redacted": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "redacted": { "const": true } },
            "required": ["redacted"]
          },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        }
      ]
    }
  }
}
