{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebinder.dev/schemas/0.1.0/conversation-item.schema.json",
  "title": "Canonical conversation item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "parentId": { "type": ["string", "null"], "minLength": 1 },
    "role": { "enum": ["system", "user", "assistant", "tool"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/text" },
          { "$ref": "#/$defs/toolCall" },
          { "$ref": "#/$defs/toolResult" },
          { "$ref": "#/$defs/attachment" }
        ]
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "callId", "name", "input"],
      "properties": {
        "type": { "const": "tool_call" },
        "callId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": true
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "callId", "output", "isError"],
      "properties": {
        "type": { "const": "tool_result" },
        "callId": { "type": "string", "minLength": 1 },
        "output": true,
        "isError": { "type": "boolean" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "mediaType"],
      "properties": {
        "type": { "const": "attachment" },
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 }
      }
    }
  }
}
