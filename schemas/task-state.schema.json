{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebinder.dev/schemas/0.1.0/task-state.schema.json",
  "title": "Canonical task state",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "status", "plan", "decisions", "constraints", "openQuestions"],
  "properties": {
    "intent": { "type": "string", "minLength": 1 },
    "status": { "enum": ["not_started", "in_progress", "blocked", "completed"] },
    "plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/planStep" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "in_progress", "completed"] },
        "notes": { "type": "string" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" }
      }
    }
  }
}
